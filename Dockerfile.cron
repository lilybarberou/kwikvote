# Utiliser une image Node.js légère, à la même version que l'application
# (nixpacks.toml) : Node 22.18 ou plus est nécessaire pour charger
# lib/registration.ts (types retirés par Node).
# Changer ensemble nixpacks.toml, Dockerfile.cron, Dockerfile.prisma et
# .node-version.
FROM node:22.23.5-alpine

# Définir le répertoire de travail
WORKDIR /app

# OpenSSL est nécessaire au moteur Prisma ; garder pnpm aligné sur packageManager.
RUN apk add --no-cache openssl \
    && npm install --global pnpm@10.15.0

# Installer les versions verrouillées, y compris Prisma pour la génération.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod=false --ignore-scripts

# Copier le schéma Prisma et le cron
COPY prisma ./prisma
COPY cron.js ./cron.js
# les règles d'inscription de l'application, chargées par node (Node 22.18 ou
# plus retire lui-même les types du fichier TypeScript)
COPY lib/registration.ts ./lib/registration.ts

# Exécuter `prisma generate` pour générer le client
RUN pnpm exec prisma generate

# Commande pour lancer le cron
# sans l'avertissement « type stripping is an experimental feature » à chaque démarrage
CMD ["node", "--disable-warning=ExperimentalWarning", "cron.js"]
