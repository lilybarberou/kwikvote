# Utiliser une image Node.js légère
FROM node:22-alpine

# Définir le répertoire de travail
WORKDIR /app

# OpenSSL est nécessaire au moteur Prisma ; garder pnpm aligné sur packageManager.
RUN apk add --no-cache openssl \
    && npm install --global pnpm@10.15.0

# Prisma Studio utilise la CLI et le client définis dans le lockfile.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod=false --ignore-scripts

# Copier le fichier schema.prisma pour Prisma Studio
COPY prisma ./prisma

# Exécuter `prisma generate` pour générer le client
RUN pnpm exec prisma generate

# Exposer le port de Prisma Studio (par défaut 5555)
EXPOSE 5555

# Commande pour lancer Prisma Studio
CMD ["pnpm", "exec", "prisma", "studio", "--browser", "none"]
